---
import '../styles/global.css';
import Ellipse from '../components/Ellipse.astro';

interface Props {
  titre?: string;
  description?: string;
  image?: string;
  accent?: string;
}

const {
  titre,
  description = 'Marie-Ange Viard, graphiste et directrice artistique junior à Paris : édition, identité visuelle, affiches et interfaces.',
  image = '/projets/deux-guerres-une-vie/01.webp',
  accent,
} = Astro.props;

const titreComplet = titre ? `${titre} · Marie-Ange Viard` : 'Marie-Ange Viard · Graphiste à Paris';
const url = new URL(Astro.url.pathname, Astro.site);
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Projets' },
  { href: '/a-propos', label: 'À propos' },
];
---
<!doctype html>
<html lang="fr" style={accent ? `--accent: ${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="theme-color" content="#fbfaf7" />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-anim');
      }
    </script>
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <header class="entete cadre">
      <a class="signature" href="/">Marie-Ange Viard</a>
      <nav aria-label="Navigation principale">
        <ul>
          {nav.map((l) => (
            <li class={l.href === '/' ? 'lien-nav cache-mobile' : 'lien-nav'}>
              <a href={l.href} aria-current={chemin === l.href ? 'page' : undefined}>{l.label}</a>
            </li>
          ))}
          <li class="lien-nav cache-mobile"><a href="/cv-marie-ange-viard.pdf" download>CV</a></li>
          <li><a class="bouton" href="/contact" aria-current={chemin === '/contact' ? 'page' : undefined}>Écrivez-moi</a></li>
        </ul>
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied cadre">
      <p class="pied-titre titre-fin">
        Un poste, un projet ?<br />
        <a href="mailto:ma.projetgraphique@gmail.com" class="pied-mail"><Ellipse marge={0.18}><span class="it">Écrivez-moi</span></Ellipse></a>
      </p>
      <div class="pied-bas">
        <span>© {new Date().getFullYear()} Marie-Ange Viard · Paris</span>
        <span class="pied-liens">
          <a href="mailto:ma.projetgraphique@gmail.com">ma.projetgraphique@gmail.com</a>
          <a href="https://www.linkedin.com/in/marieangeviard/" rel="me noopener">LinkedIn</a>
        </span>
      </div>
    </footer>

    <script>
      import '../scripts/animations.ts';
    </script>
  </body>
</html>

<style>
  .entete {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 22px;
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--fond) 90%, transparent);
    backdrop-filter: blur(10px);
  }
  .signature { text-decoration: none; font-size: 0.9375rem; font-weight: 450; letter-spacing: -0.01em; }
  nav ul { display: flex; align-items: center; gap: clamp(14px, 2.4vw, 32px); list-style: none; margin: 0; padding: 0; font-size: 0.8125rem; }
  .lien-nav a { text-decoration: none; color: var(--gris); transition: color 0.2s; }
  .lien-nav a:hover, .lien-nav a[aria-current='page'] { color: var(--encre); }

  .pied { margin-top: clamp(120px, 16vw, 220px); padding-bottom: 28px; }
  .pied-titre { font-size: clamp(2.5rem, 7vw, 6rem); padding-top: 40px; border-top: 1px solid var(--encre); }
  .pied-mail { text-decoration: none; display: inline-block; margin-top: 0.12em; }
  .pied-mail:hover { color: var(--gris); }
  .pied-bas {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    margin-top: clamp(56px, 8vw, 96px); font-size: 0.8125rem; color: var(--gris);
  }
  .pied-liens { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .pied-liens a { text-decoration: none; }
  .pied-liens a:hover { color: var(--encre); }

  @media (max-width: 600px) {
    .entete { padding-block: 14px; }
    .cache-mobile { display: none; }
  }
</style>
