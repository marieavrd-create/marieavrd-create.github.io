---
import Base from '../layouts/Base.astro';
import Ellipse from '../components/Ellipse.astro';
import CarteVisuel from '../components/CarteVisuel.astro';
import { projets, filtres } from '../data/projets';

const presents = filtres.filter((f) => projets.some((p) => p.filtres.includes(f.id)));
---
<Base>
  <section class="ouverture cadre" aria-labelledby="titre-accueil">
    <h1 id="titre-accueil" class="titre-fin titre">
      <span class="ligne" data-apparait>Graphiste &amp; <Ellipse marge={0.14}><span class="it">directrice</span></Ellipse></span>
      <span class="ligne" data-apparait data-delai="0.08">artistique junior</span>
    </h1>
    <div class="ouverture-bas">
      <p class="intro" data-apparait data-delai="0.15">
        Je conçois des supports print et digitaux clairs et cohérents, de l’édition à l’affiche,
        de la charte à l’interface. Formée chez <strong>Belin Éducation</strong> et <strong>Bureau des goodies</strong>. Basée à Paris.
      </p>
      <ul class="points" aria-hidden="true" data-apparait data-delai="0.2">
        {projets.map((p) => <li><span class="point" style={`--c: ${p.couleur}`} /></li>)}
      </ul>
    </div>
    <dl class="chiffres" data-apparait data-delai="0.25">
      <div><dt class="titre-fin">300+</dt><dd>pages de catalogues mises en page</dd></div>
      <div><dt class="titre-fin">Print → BAT</dt><dd>chaîne graphique suivie jusqu’à la production</dd></div>
    </dl>
  </section>

  <section id="projets" class="cadre projets" aria-label="Projets">
    <div class="barre-filtres">
      <div class="filtres" role="group" aria-label="Filtrer les projets">
        <button type="button" class="pastille pleine" data-filtre="tout" aria-pressed="true">Tout</button>
        {presents.map((f) => (
          <button type="button" class="pastille" data-filtre={f.id} aria-pressed="false">{f.label}</button>
        ))}
      </div>
      <span class="compte" aria-live="polite"><span data-compte>{projets.length}</span> projets</span>
    </div>

    <ul class="grille-projets">
      {projets.map((p, i) => (
        <li class="carte" data-filtres={p.filtres.join(' ')} style={`--c: ${p.couleur}`}>
          <a href={`/projets/${p.slug}`}>
            <div class="carte-img">
              <CarteVisuel projet={p} prioritaire={i < 2} />
            </div>
            <div class="carte-legende">
              <span class="carte-titre"><span class="point" />{p.titre}</span>
              <span class="it carte-cat">{p.categorie}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .ouverture { padding-top: clamp(56px, 9vw, 128px); }
  .titre { font-size: clamp(2.6rem, 7.2vw, 6.75rem); }
  .ligne { display: block; }
  .titre .it { font-size: 0.98em; }

  .ouverture-bas {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;
    margin-top: clamp(28px, 4vw, 48px);
  }
  .intro { margin: 0; max-width: 46ch; font-size: clamp(0.9375rem, 1.2vw, 1.0625rem); line-height: 1.6; }
  .intro strong { font-weight: 550; }
  .points { display: flex; gap: 7px; list-style: none; margin: 0; padding: 0 0 6px; }

  .chiffres {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gouttiere);
    margin: clamp(48px, 7vw, 88px) 0 0;
  }
  .chiffres > div { border-top: 1px solid var(--encre); padding-top: 14px; }
  .chiffres dt { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .chiffres dd { margin: 8px 0 0; font-size: 0.8125rem; color: var(--gris); max-width: 28ch; }

  .projets { margin-top: clamp(72px, 10vw, 140px); }
  .barre-filtres {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding-bottom: 20px; border-bottom: 1px solid var(--filet); margin-bottom: clamp(24px, 3vw, 36px);
  }
  .filtres { display: flex; flex-wrap: wrap; gap: 8px; }
  .filtres button { cursor: pointer; font-family: inherit; transition: background 0.2s, color 0.2s; }
  .filtres button:hover { background: var(--fond-2); }
  .filtres button[aria-pressed='true'] { background: var(--encre); color: var(--fond); }
  .compte { font-size: 0.75rem; color: var(--gris); white-space: nowrap; }

  .grille-projets {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px) var(--gouttiere);
  }
  .carte[hidden] { display: none; }
  .carte a { display: block; text-decoration: none; }
  .carte-img { border-radius: var(--rayon); overflow: hidden; background: var(--fond-2); }
  .carte-legende { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 12px; }
  .carte-titre { display: inline-flex; align-items: center; gap: 9px; font-size: 0.9375rem; font-weight: 450; }
  .carte-titre .point { transform: translateY(-1px); }
  .carte-cat { font-size: 0.875rem; color: var(--gris); text-align: right; }

  @media (max-width: 760px) {
    .ouverture-bas { flex-direction: column; align-items: flex-start; }
    .chiffres { grid-template-columns: 1fr; gap: 20px; }
    .barre-filtres { flex-direction: column; align-items: flex-start; }
    .filtres { flex-wrap: nowrap; overflow-x: auto; max-width: 100%; padding-bottom: 4px; scrollbar-width: none; }
    .grille-projets { grid-template-columns: 1fr; }
  }
</style>

<script>
  const boutons = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
  const cartes = document.querySelectorAll<HTMLElement>('.carte');
  const compte = document.querySelector('[data-compte]');
  boutons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filtre!;
      boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let n = 0;
      cartes.forEach((c) => {
        const ok = f === 'tout' || c.dataset.filtres!.split(' ').includes(f);
        c.hidden = !ok;
        if (ok) n++;
      });
      if (compte) compte.textContent = String(n);
    }),
  );
</script>
