---
import Base from '../../layouts/Base.astro';
import { projets, type Projet } from '../../data/projets';

export function getStaticPaths() {
  return projets.map((p, i) => ({
    params: { slug: p.slug },
    props: { projet: p, index: i },
  }));
}

const { projet, index } = Astro.props as { projet: Projet; index: number };
const suivant = projets[(index + 1) % projets.length];
const [couverture, ...galerie] = projet.visuels;
const fiche = [
  ['Cadre', projet.cadre],
  ['Année', projet.annee],
  ['Rôle', projet.role],
  ['Outils', projet.outils?.join(', ')],
].filter(([, val]) => val) as [string, string][];
---
<Base titre={projet.titre} description={`${projet.titre} : ${projet.accroche}. Projet de Marie-Ange Viard, graphiste.`} image={couverture.src}>
  <article>
    <header class="cadre tete">
      <a class="retour" href="/#projets">← Sommaire</a>
      <p class="surtitre" data-apparait>{String(index + 1).padStart(2, '0')} · {projet.categorie}</p>
      <h1 class="serif" data-apparait>{projet.titre}</h1>
      <p class="accroche serif" data-apparait data-delai="0.1"><em>{projet.accroche}</em></p>
    </header>

    <figure class="cadre couverture" data-apparait data-delai="0.2">
      <div class="reperes"><img src={couverture.src} alt={couverture.alt} fetchpriority="high" /></div>
    </figure>

    <section class="cadre grille corps">
      <dl class="fiche">
        {fiche.map(([k, val]) => (
          <div><dt>{k}</dt><dd>{val}</dd></div>
        ))}
        <div>
          <dt>Livrables</dt>
          <dd><ul>{projet.livrables.map((l) => <li>{l}</li>)}</ul></dd>
        </div>
      </dl>
      <div class="texte">
        {projet.texte.map((t) => <p data-apparait>{t}</p>)}
      </div>
    </section>

    <section class="cadre galerie" aria-label="Visuels du projet">
      {galerie.map((img) => (
        <figure class={`vis vis-${img.format ?? 'paysage'}`} data-apparait>
          <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
          <figcaption>{img.alt}</figcaption>
        </figure>
      ))}
    </section>

    <nav class="cadre suivant" aria-label="Projet suivant">
      <span class="surtitre">Projet suivant</span>
      <a href={`/projets/${suivant.slug}`} class="serif">{suivant.titre} →</a>
    </nav>
  </article>
</Base>

<style>
  .tete { padding-top: clamp(32px, 6vw, 80px); padding-bottom: clamp(32px, 5vw, 56px); }
  .retour { font-size: 0.875rem; text-decoration: none; color: var(--encre-2); display: inline-block; margin-bottom: clamp(32px, 5vw, 64px); }
  .retour:hover { color: var(--encre); }
  h1 { margin: 12px 0 0; font-size: clamp(3rem, 9vw, 8.5rem); line-height: 0.92; letter-spacing: -0.02em; }
  .accroche { margin: 16px 0 0; font-size: clamp(1.35rem, 2.6vw, 2.25rem); line-height: 1.15; color: var(--encre-2); max-width: 30ch; }

  .couverture { margin: 0 auto; }
  .couverture img { width: 100%; background: var(--papier-2); }

  .corps { margin-top: clamp(56px, 8vw, 120px); row-gap: 40px; }
  .fiche { grid-column: 1 / span 4; margin: 0; font-size: 0.875rem; align-self: start; position: sticky; top: 96px; }
  .fiche > div { display: grid; grid-template-columns: 6.5rem 1fr; gap: 12px; padding-block: 10px; border-top: 1px solid var(--filet); }
  .fiche > div:last-child { border-bottom: 1px solid var(--filet); }
  dt { color: var(--encre-2); }
  dd { margin: 0; }
  dd ul { margin: 0; padding: 0; list-style: none; }
  .texte { grid-column: 6 / span 7; }
  .texte p { margin: 0 0 1.1em; font-size: clamp(1.05rem, 1.35vw, 1.25rem); line-height: 1.6; max-width: 62ch; }
  .texte p:first-child::first-letter {
    font-family: var(--serif); float: left; font-size: 4.2em; line-height: 0.82; padding: 0.06em 0.08em 0 0; color: var(--repere);
  }

  .galerie {
    margin-top: clamp(72px, 10vw, 160px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gouttiere);
    row-gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .vis { margin: 0; }
  .vis img { width: 100%; background: var(--papier-2); }
  .vis figcaption { margin-top: 10px; font-size: 0.8125rem; color: var(--encre-2); }
  .vis-large { grid-column: 1 / -1; }
  .vis-paysage { grid-column: span 6; }
  .vis-portrait { grid-column: span 4; }
  .vis-paysage:nth-of-type(4n + 1) { grid-column: 1 / span 7; }
  .vis-paysage:nth-of-type(4n + 2) { grid-column: 8 / span 5; margin-top: clamp(40px, 8vw, 120px); }

  .suivant { margin-top: clamp(96px, 14vw, 200px); display: grid; gap: 8px; }
  .suivant a { font-size: clamp(2.25rem, 7vw, 6rem); line-height: 1; text-decoration: none; width: fit-content; }
  .suivant a:hover { color: var(--repere); }

  @media (max-width: 860px) {
    .fiche, .texte { grid-column: 1 / -1; position: static; }
    .vis-paysage, .vis-portrait,
    .vis-paysage:nth-of-type(4n + 1), .vis-paysage:nth-of-type(4n + 2) { grid-column: 1 / -1; margin-top: 0; }
  }
</style>
