---
import Base from '../../layouts/Base.astro';
import Ellipse from '../../components/Ellipse.astro';
import Livre3D from '../../components/Livre3D.astro';
import Lecture from '../../components/Lecture.astro';
import Diaporama from '../../components/Diaporama.astro';
import EsquareScene from '../../components/EsquareScene.astro';
import { projets, type Projet } from '../../data/projets';

export function getStaticPaths() {
  return projets.map((p, i) => ({
    params: { slug: p.slug },
    props: { projet: p, index: i },
  }));
}

const { projet, index } = Astro.props as { projet: Projet; index: number };
const suivant = projets[(index + 1) % projets.length];
const [couverture, ...galerie] = projet.visuels;
const num = String(index + 1).padStart(2, '0');
const bandeau = [
  ['Rôle', projet.role],
  ['Livrables', projet.livrables],
  ['Outils', projet.outils],
  ['Équipe', projet.equipe],
  ['Cadre', projet.cadre],
].filter(([, v]) => v) as [string, string][];
---
<Base titre={projet.titre} description={projet.resume} image={couverture.src} accent={projet.couleur}>
  <article style={`--c: ${projet.couleur}`}>
    <header class="cadre tete">
      <a class="retour" href="/#projets">← Tous les projets</a>
      <p class="numero" data-apparait><span class="point" /><span>{num}</span><span class="numero-cat">{projet.categorie}</span></p>
      <div class="tete-grille">
        <h1 class="titre-fin" data-apparait><Ellipse marge={0.16}>{projet.titre}</Ellipse></h1>
        <p class="resume" data-apparait data-delai="0.1">{projet.resume}</p>
      </div>
      <dl class="bandeau" data-apparait data-delai="0.15">
        {bandeau.map(([k, v]) => (
          <div><dt class="surtitre">{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </header>

    <figure class="cadre couverture" data-apparait data-delai="0.2">
      <img src={couverture.src} alt={couverture.alt} fetchpriority="high" />
    </figure>

    <section class="cadre recit">
      <div class="bloc" data-apparait>
        <h2 class="surtitre">Le contexte</h2>
        <p>{projet.contexte}</p>
      </div>
      <div class="bloc" data-apparait>
        <h2 class="surtitre">Réalisations</h2>
        <ol class="taches">
          {projet.taches.map((t) => <li>{t}</li>)}
        </ol>
        <ul class="etiquettes">
          {projet.etiquettes.map((e) => <li class="pastille">{e}</li>)}
        </ul>
      </div>
    </section>

    {projet.slug === 'deux-guerres-une-vie' && <Livre3D />}
    {projet.slug === 'e-square' && <EsquareScene />}

    <section class="cadre galerie" aria-label="Visuels du projet">
      {galerie.map((img) => (
        <figure class={`vis vis-${img.format ?? 'moitie'}`} data-apparait>
          <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
          <figcaption aria-hidden="true">{img.alt}</figcaption>
        </figure>
      ))}
    </section>

    {projet.presentation && <Diaporama {...projet.presentation} couleur={projet.couleur} />}
    {projet.lecture && <Lecture {...projet.lecture} couleur={projet.couleur} />}

    <nav class="cadre suivant" aria-label="Projet suivant" style={`--c: ${suivant.couleur}`}>
      <span class="surtitre"><span class="point" /> Projet suivant</span>
      <a href={`/projets/${suivant.slug}`} class="titre-fin">{suivant.titre} <span class="it">→</span></a>
    </nav>
  </article>
</Base>

<style>
  .tete { padding-top: clamp(28px, 5vw, 64px); }
  .retour { font-size: 0.8125rem; text-decoration: none; color: var(--gris); }
  .retour:hover { color: var(--encre); }
  .numero {
    display: flex; align-items: center; gap: 12px;
    margin: clamp(32px, 5vw, 56px) 0 clamp(16px, 2.4vw, 28px);
    font-size: 0.9375rem; font-weight: 450; font-variant-numeric: tabular-nums;
  }
  .numero-cat { color: var(--gris); font-weight: 400; }
  .tete-grille { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--gouttiere) clamp(24px, 5vw, 80px); align-items: end; }
  h1 { font-size: clamp(2.75rem, 7.6vw, 7rem); }
  h1 :global(.ellipse) { white-space: normal; }
  .resume { margin: 0; font-size: clamp(1rem, 1.3vw, 1.125rem); line-height: 1.6; max-width: 46ch; }

  .bandeau {
    display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); gap: var(--gouttiere);
    margin: clamp(32px, 5vw, 56px) 0 0; padding: 14px 0; border-top: 1px solid var(--encre); border-bottom: 1px solid var(--filet);
  }
  .bandeau { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .bandeau dt { margin-bottom: 6px; }
  .bandeau dd { margin: 0; font-size: 0.8125rem; line-height: 1.45; }

  .couverture { margin: clamp(28px, 4vw, 48px) auto 0; }
  .couverture img { width: 100%; border-radius: var(--rayon); background: var(--fond-2); }

  .recit {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(64px, 9vw, 128px);
  }
  .bloc h2 { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; color: var(--encre); }
  .bloc p { margin: 0; font-size: clamp(1.0625rem, 1.5vw, 1.375rem); line-height: 1.5; font-weight: 350; letter-spacing: -0.005em; }
  .taches { list-style: none; margin: 0; padding: 0; counter-reset: t; }
  .taches li {
    counter-increment: t; display: grid; grid-template-columns: 2.25rem 1fr; gap: 8px;
    padding: 10px 0; border-bottom: 1px solid var(--filet);
    font-size: clamp(1rem, 1.25vw, 1.1875rem); line-height: 1.45; font-weight: 350;
  }
  .taches li:first-child { border-top: 1px solid var(--filet); }
  .taches li::before { content: counter(t, decimal-leading-zero); font-size: 0.75rem; color: var(--gris); padding-top: 0.3em; font-variant-numeric: tabular-nums; }
  .etiquettes { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 24px 0 0; padding: 0; }

  .galerie {
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px) var(--gouttiere);
    margin-top: clamp(64px, 9vw, 128px); align-items: start;
  }
  .vis { margin: 0; }
  .vis img { width: 100%; border-radius: var(--rayon); background: var(--fond-2); }
  .vis figcaption { margin-top: 10px; font-size: 0.75rem; color: var(--gris); }
  .vis-large { grid-column: 1 / -1; }
  .vis-moitie { grid-column: span 3; }
  .vis-tiers { grid-column: span 2; }

  .suivant { margin-top: clamp(96px, 12vw, 160px); display: grid; gap: 14px; }
  .suivant .surtitre { display: flex; align-items: center; gap: 10px; }
  .suivant a { font-size: clamp(2.25rem, 6vw, 5.5rem); text-decoration: none; width: fit-content; }
  .suivant a:hover { color: var(--gris); }

  @media (max-width: 760px) {
    .tete-grille, .recit { grid-template-columns: 1fr; }
    .bandeau { grid-template-columns: 1fr 1fr; }
    .vis-moitie, .vis-tiers { grid-column: 1 / -1; }
  }
</style>
