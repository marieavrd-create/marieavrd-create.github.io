---
import Base from '../layouts/Base.astro';
import Ellipse from '../components/Ellipse.astro';
---
<Base titre="Contact" description="Contacter Marie-Ange Viard, graphiste et directrice artistique junior à Paris.">
  <section class="cadre contact">
    <p class="surtitre" data-apparait>Contact</p>
    <h1 class="titre-fin" data-apparait>Parlons de votre <Ellipse marge={0.14}><span class="it">projet</span></Ellipse>,<br />ou de votre poste.</h1>
    <dl class="coord" data-apparait data-delai="0.15">
      <div><dt class="surtitre">E-mail</dt><dd><a href="mailto:ma.projetgraphique@gmail.com">ma.projetgraphique@gmail.com</a></dd></div>
      <div><dt class="surtitre">LinkedIn</dt><dd><a href="https://www.linkedin.com/in/marieangeviard/" rel="me noopener">Marie-Ange Viard</a></dd></div>
      <div><dt class="surtitre">CV</dt><dd><a href="/cv-marie-ange-viard.pdf" download>Télécharger le PDF</a></dd></div>
      <div><dt class="surtitre">Ville</dt><dd>Paris</dd></div>
    </dl>
  </section>
</Base>

<style>
  .contact { padding-top: clamp(40px, 7vw, 96px); }
  h1 { margin-top: 20px; font-size: clamp(2.5rem, 7vw, 6.25rem); }
  .coord { margin: clamp(48px, 7vw, 96px) 0 0; max-width: 820px; }
  .coord > div { display: grid; grid-template-columns: 8rem 1fr; gap: 16px; align-items: baseline; padding-block: 16px; border-top: 1px solid var(--filet); font-size: clamp(1rem, 1.6vw, 1.375rem); font-weight: 350; }
  .coord > div:last-child { border-bottom: 1px solid var(--filet); }
  dd { margin: 0; overflow-wrap: anywhere; }
  dd a { text-decoration: none; }
  dd a:hover { text-decoration: underline; }
  @media (max-width: 560px) { .coord > div { grid-template-columns: 1fr; gap: 4px; } }
</style>
