---
import Base from '../layouts/Base.astro';
---
<Base titre="Contact" description="Contacter Marie-Ange Viard, graphiste junior print et digital à Paris.">
  <section class="cadre contact">
    <p class="surtitre" data-apparait>Contact</p>
    <h1 class="serif" data-apparait>Disponible pour un poste<br /><em>en CDI ou en CDD, à Paris.</em></h1>
    <dl class="coord">
      <div><dt>E-mail</dt><dd><a href="mailto:ma.projetgraphique@gmail.com">ma.projetgraphique@gmail.com</a></dd></div>
      <div><dt>LinkedIn</dt><dd><a href="https://www.linkedin.com/in/marieangeviard/" rel="me noopener">linkedin.com/in/marieangeviard</a></dd></div>
      <div><dt>CV</dt><dd><a href="/cv-marie-ange-viard.pdf" download>Télécharger le PDF</a></dd></div>
      <div><dt>Ville</dt><dd>Paris</dd></div>
    </dl>
  </section>
</Base>

<style>
  .contact { padding-top: clamp(40px, 8vw, 120px); }
  h1 { margin: 12px 0 0; font-size: clamp(2.5rem, 7vw, 6.5rem); line-height: 0.95; letter-spacing: -0.02em; max-width: 16ch; }
  h1 em { color: var(--repere); }
  .coord { margin: clamp(48px, 7vw, 96px) 0 0; max-width: 760px; }
  .coord > div { display: grid; grid-template-columns: 8rem 1fr; gap: 16px; padding-block: 16px; border-top: 1px solid var(--filet); font-size: clamp(1rem, 1.6vw, 1.25rem); }
  .coord > div:last-child { border-bottom: 1px solid var(--filet); }
  dt { color: var(--encre-2); font-size: 0.875rem; padding-top: 0.2em; }
  dd { margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 560px) { .coord > div { grid-template-columns: 1fr; gap: 2px; } }
</style>
